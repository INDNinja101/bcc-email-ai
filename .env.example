# Copy this file to .env and fill in your real values.
# Never commit your actual .env file to GitHub.

# --- IMAP settings for your dedicated BCC archive mailbox ---
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
BCC_EMAIL_ACCOUNT=your-archive-account@gmail.com
BCC_EMAIL_PASSWORD=your-16-character-app-password
IMAP_FOLDER=INBOX

# Your own sending addresses, comma-separated. Emails FROM these (outgoing mail
# you BCC'd to the archive) are filed under the recipient instead of you.
MY_EMAIL_ADDRESSES=you@yourcompany.com

# --- Database ---
DB_PATH=emails.db

# --- AI summarization provider: anthropic | openai | gemini ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Optional model overrides (defaults shown) ---
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-flash-latest
# SUMMARY_MAX_TOKENS=1024
